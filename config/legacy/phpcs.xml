<?xml version="1.0"?>
<ruleset name="Pure legacy">
    <description>Company standard minus the rules a PHP 5 era codebase can't follow. Pick it with profile: legacy.</description>
    <rule ref="../phpcs.xml">
        <!-- No namespaces, snake_case methods, files that declare and execute -->
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
        <exclude name="PSR1.Methods.CamelCapsMethodName"/>
        <exclude name="PSR1.Files.SideEffects"/>
    </rule>
</ruleset>
