#!/usr/bin/env bash
# Pure: runs the Pure PHP checks and prints a summary report.
#   PURE_BASE          git ref to diff against (the PR base); unset = all tracked PHP files
#   PURE_FORMAT        text (default) | github (annotations) | gitlab (text log + Code Quality files in pure-reports/)
#   PHPSTAN_LEVEL      used only when the project has no phpstan.neon (default 1)
#   PURE_TEST_VERSION  PHPCompatibility testVersion (default "<this PHP>-", e.g. "7.4-")
#   PURE_PROFILE       default | legacy (config/<profile>/: relaxed rules for pre-namespace code)
set -uo pipefail

format=${PURE_FORMAT:-text}
php_version=$(php -r 'echo PHP_MAJOR_VERSION . "." . PHP_MINOR_VERSION;')
git config --global --add safe.directory "$PWD"

config=/opt/pure/config
[ "${PURE_PROFILE:-default}" != default ] && config=$config/$PURE_PROFILE
[ -f "$config/phpcs.xml" ] || { echo "Pure: unknown profile '$PURE_PROFILE'" >&2; exit 2; }

# A git failure must not look like "nothing to check" and pass the build.
if [ -n "${PURE_BASE:-}" ]; then
  list=$(git diff --name-only --diff-filter=ACMR "$PURE_BASE"...HEAD -- '*.php' ':!vendor/') ||
    { echo "Pure: cannot diff against $PURE_BASE (checkout with fetch-depth: 0?)" >&2; exit 2; }
else
  list=$(git ls-files -- '*.php' ':!vendor/') || { echo "Pure: not a git repository" >&2; exit 2; }
fi
if [ -z "$list" ]; then
  echo "Pure: no PHP files to check."
  exit 0
fi
mapfile -t files <<<"$list"

reports=pure-reports
if [ "$format" = gitlab ]; then rm -rf "$reports" && mkdir "$reports"; fi

has_any() { for f; do [ -f "$f" ] && return 0; done; return 1; }

if [ -f composer.json ] && [ ! -d vendor ]; then
  composer install --no-scripts --no-progress --no-interaction --ignore-platform-reqs ||
    echo "Pure: composer install failed, PHPStan may report unknown classes" >&2
fi

lint() {
  case $format in
    github) parallel-lint --checkstyle "${files[@]}" | cs2pr ;;
    gitlab) parallel-lint --gitlab "${files[@]}" >"$reports/syntax.json"; parallel-lint "${files[@]}" ;;
    *) parallel-lint "${files[@]}" ;;
  esac
}

analyse() {
  local args=(analyse --no-progress --memory-limit=1G)
  [ "$format" = github ] && args+=(--error-format=github)
  has_any phpstan.neon phpstan.neon.dist phpstan.dist.neon ||
    args+=(-c /opt/pure/config/phpstan.neon --level="${PHPSTAN_LEVEL:-1}")
  # gitlab: the second run (for the log) is served from PHPStan's result cache.
  [ "$format" = gitlab ] && phpstan "${args[@]}" --error-format=gitlab "${files[@]}" >"$reports/phpstan.json"
  phpstan "${args[@]}" "${files[@]}"
}

# sniff <report name> <phpcs args...>
sniff() {
  local name=$1; shift
  case $format in
    github) phpcs -q --report=checkstyle "$@" "${files[@]}" | cs2pr --errors-as-warnings ;;
    gitlab) phpcs -q --basepath=. --report=full --report-\\Micheh\\PhpCodeSniffer\\Report\\Gitlab="$reports/$name.json" "$@" "${files[@]}" ;;
    *) phpcs -q "$@" "${files[@]}" ;;
  esac
}

style() {
  local args=()
  has_any phpcs.xml phpcs.xml.dist .phpcs.xml .phpcs.xml.dist || args+=(--standard="$config/phpcs.xml")
  sniff style "${args[@]}"
}

compat() { sniff compat --standard=PHPCompatibility --runtime-set testVersion "${PURE_TEST_VERSION:-$php_version-}"; }

mess() {
  local renderer=text extra=()
  [ "$format" = github ] && renderer=github
  [ "$format" = gitlab ] && extra=(--reportfile-gitlab "$reports/phpmd.json")
  phpmd "$(IFS=,; echo "${files[*]}")" "$renderer" codesize,unusedcode "${extra[@]}"
}

audit() { composer audit --no-interaction; }

rows=()
failed=0
# check <name> <gate|warn> <function>: runs every check, even after a failure.
check() {
  [ "$format" = github ] && echo "::group::$1" || echo "== $1"
  if "$3"; then rows+=("| $1 | ✅ passed |")
  elif [ "$2" = gate ]; then rows+=("| $1 | ❌ failed |"); failed=1
  else rows+=("| $1 | ⚠️ warnings |"); fi
  [ "$format" = github ] && echo "::endgroup::"
}

check "Syntax (PHP $php_version)" gate lint
check "Static analysis (PHPStan)" gate analyse
[ -f composer.lock ] && check "Dependency security (composer audit)" gate audit
check "Coding standard (PHPCS)" warn style
check "PHP compatibility (${PURE_TEST_VERSION:-$php_version-})" warn compat
check "Complexity & unused code (PHPMD)" warn mess

report="## Pure report

${#files[@]} PHP files checked with PHP $php_version.

| Check | Result |
|---|---|
$(printf '%s\n' "${rows[@]}")"
[[ "$report" == *"PHPCS) | ⚠️"* ]] && report+=$'\n\nMost coding standard issues can be fixed automatically with `phpcbf`.'

echo
echo "$report"
[ -n "${GITHUB_STEP_SUMMARY:-}" ] && echo "$report" >>"$GITHUB_STEP_SUMMARY"
exit "$failed"
